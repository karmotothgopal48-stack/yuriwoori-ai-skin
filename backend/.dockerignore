# --- Secrets: never send these into the build context ---
.env
.env.*
!.env.example
.secrets/
*service-account*.json
*service_account*.json

# --- Python environments ---
venv/
.venv/
__pycache__/
*.pyc
*.pyo

# --- Local development artifacts (do not belong in the production image) ---
app/uploads/
uploads/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Dev/test-only source, not required to run the app (see Dockerfile) ---
tests/
scripts/

# --- VCS / editor / tooling ---
.git/
.gitignore
.claude/
.vscode/
.idea/
*.log
