# Copy to .env and fill in. Never commit .env.

# PostgreSQL (needs the pgvector extension). Example for a local Docker container:
# docker run -d --name yuriwoori-db -e POSTGRES_USER=yuriwoori_user -e POSTGRES_PASSWORD=<your-password> -e POSTGRES_DB=yuriwoori_db -p 5432:5432 pgvector/pgvector:pg16
DATABASE_URL=postgresql://yuriwoori_user:<your-password>@localhost:5432/yuriwoori_db

# Comma-separated browser origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:2999,http://127.0.0.1:2999

# Yuri AI assistant (Anthropic)
ANTHROPIC_API_KEY=
# Optional: Claude model for Ask Yuri, and the longest wait for one reply (seconds)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_TIMEOUT_SECONDS=30

# Official YuriWoori store = the product catalogue. Products, prices, availability, variants and product copy
# are read live from its public Shopify feed and product pages (no credentials); checkout via its Shopify cart.
YURIWOORI_STORE_URL=https://yuriwoori.com

# Optional live-catalogue tuning (defaults shown): feed reuse, unchanged product-copy reuse, how long the last
# copy may still serve (flagged stale) when the store is unreachable, and the per-request timeout. Seconds.
# CATALOGUE_CACHE_SECONDS=300
# CATALOGUE_CONTENT_CACHE_SECONDS=3600
# CATALOGUE_STALE_GRACE_SECONDS=900
# CATALOGUE_TIMEOUT_SECONDS=10

# Shopify Storefront GraphQL API: the product catalogue and the cart (priced by Shopify, with its discounts).
# Works WITHOUT a token. A token is only needed to read the custom.* metafields (benefits, chips, keybenefit,
# how_to_use, inci) through the API: it needs the `unauthenticated_read_metafields` scope, and those
# metafields must be exposed to the storefront in Shopify admin. Without it, that copy is read from the
# product pages. Tokens stay on the server: never put them in the frontend .env.
# SHOPIFY_STORE_DOMAIN=yuriwoori.myshopify.com   (empty = YURIWOORI_STORE_URL)
# SHOPIFY_API_VERSION=2025-07
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ===== Customer report delivery (email + WhatsApp) — see README "Customer report delivery: local setup" =====
# Each channel stays OFF until its settings are filled in. Reports only go to the customer's own email /
# WhatsApp number, only with their consent, and only after they confirm the contact with a one-time code.
# Secrets and account IDs are left EMPTY on purpose: never commit real values. Check the result, without
# sending anything, with:  python scripts/check_delivery_config.py

# --- Delivery test mode (ON by default) ---
# While true, codes and reports are sent ONLY to the contacts listed below; every other customer's delivery stays
# pending ("test mode") and nothing is sent to them. Reports are never redirected. Set false only to go live.
DELIVERY_TEST_MODE=true
# Comma-separated. e.g. DELIVERY_TEST_EMAILS=you@example.com
DELIVERY_TEST_EMAILS=
# Comma-separated, any format. e.g. DELIVERY_TEST_WHATSAPP=+91 98765 43210
DELIVERY_TEST_WHATSAPP=

# --- Who must verify what before a report is sent ---
# The customer's mobile (WhatsApp) number is ALWAYS verified with a one-time code before any report is sent,
# by any channel. With true (default) the email copy also waits for an email code (offered on the results page),
# so a mistyped address never receives someone's report. false sends it to the address the customer entered once
# their mobile is verified and they agreed to have it sent.
EMAIL_REPORT_REQUIRES_EMAIL_VERIFICATION=true

# --- Email (SMTP) ---
# e.g. Google Workspace (yuriwoori.com mail is on Google): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
# SMTP_USERNAME=support@yuriwoori.com, SMTP_PASSWORD=<a Google App Password; needs 2-Step Verification>
# (support@ must be a Google Workspace USER mailbox to log in; if it is a group or alias, log in as a user who
# may 'send mail as' support@, and keep SMTP_FROM as support@)
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. SMTP_FROM=YuriWoori <support@yuriwoori.com>  (the login must be allowed to send as this address; the
# domain's SPF/DKIM must allow the provider, or mail may land in spam)
SMTP_FROM=

# --- WhatsApp Business Platform (Cloud API) ---
# A system-user access token with the whatsapp_business_messaging permission, and the Phone number ID
# (Meta Business Manager > WhatsApp Manager > API setup). Needs two templates APPROVED by Meta (see README).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Template names exactly as approved, e.g. yuriwoori_code (AUTHENTICATION, copy-code button) and
# yuriwoori_report (UTILITY, 5 body variables), and the language code they were approved in.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_RESULTS_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# true only if WHATSAPP_RESULTS_TEMPLATE was approved with a DOCUMENT header: the report PDF is then sent as the
# document; false: the message carries the secure, expiring report link only
WHATSAPP_RESULTS_TEMPLATE_HAS_DOCUMENT=false
# Optional, only for scripts/check_delivery_config.py (checks the templates are approved)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Customer replies -> the team ---
# Report emails carry "Reply-To: DELIVERY_REPLY_TO", so a customer's reply reaches the team, not the sender mailbox.
# WhatsApp messages customers send to the business number arrive on the webhook below and are emailed to
# DELIVERY_REPLY_FORWARD_EMAIL (needs email configured and the webhook reachable). e.g. support@yuriwoori.com
DELIVERY_REPLY_TO=
DELIVERY_REPLY_FORWARD_EMAIL=

# --- WhatsApp webhook (optional): delivery status + customers' messages ---
# WhatsApp reports "sent" / "delivered" / "failed" and customers' messages to POST /v1/delivery/whatsapp/webhook
# (subscribe the "messages" field). It needs a public HTTPS address; without it (e.g. on a local PC) WhatsApp reports stay "accepted".
# WHATSAPP_WEBHOOK_VERIFY_TOKEN: any long random string you also enter in the Meta app's webhook settings.
# WHATSAPP_APP_SECRET: the Meta app secret (App settings > Basic), used to check X-Hub-Signature-256.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Report links ---
# The address of this frontend, used in the secure report link sent to customers (https in production;
# http://localhost:2999 links only open on this PC), and how many days a link stays valid.
FRONTEND_PUBLIC_URL=http://localhost:2999
REPORT_LINK_DAYS=30

# Signs customer session tokens and report links (min 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Signed-up customer session lifetime, in days
USER_TOKEN_DAYS=30


# --- Customer follow-up spreadsheet (Google Sheets) - backend only ---
# Off until true: submissions are still queued in PostgreSQL (customer_sheet_sync) and written once enabled.
# The backend signs in as a Google Cloud service account; share the sheet with its email (Editor). See README
# "Customer follow-up spreadsheet". Then: python scripts/customer_sheet.py check  ->  test
CUSTOMER_SHEET_SYNC_ENABLED=false
# The ID in the sheet's address: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=CustomerTracking
# Absolute path to the service account's JSON key, OUTSIDE this project (and preferably outside OneDrive),
# e.g. C:\Users\<you>\.yuriwoori\google-sheets-key.json  - never put the key's contents here.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_TIMEOUT_SECONDS=20
