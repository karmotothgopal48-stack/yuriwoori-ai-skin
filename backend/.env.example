# Copy to .env and fill in. Never commit .env.

# PostgreSQL (needs the pgvector extension). Example for a local Docker container:
# docker run -d --name yuriwoori-db -e POSTGRES_USER=yuriwoori_user -e POSTGRES_PASSWORD=<your-password> -e POSTGRES_DB=yuriwoori_db -p 5432:5432 pgvector/pgvector:pg16
DATABASE_URL=postgresql://yuriwoori_user:<your-password>@localhost:5432/yuriwoori_db

# Comma-separated browser origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:2999,http://127.0.0.1:2999

# Yuri AI assistant (Anthropic)
ANTHROPIC_API_KEY=

# Shopify Storefront API (checkout)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Reserved for future auth (currently unused)
JWT_SECRET=
